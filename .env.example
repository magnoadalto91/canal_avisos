# =============================================================================
#  ATENÇÃO: ESTE ARQUIVO É VERSIONADO E VAI PARAR NO GITHUB.
#
#  Nunca preencha nada aqui. Ele existe só para documentar quais variáveis
#  existem. Os valores de verdade vão em  .env.local , que está no .gitignore
#  e nunca é commitado:
#
#      cp .env.example .env.local     e preencha o .env.local
#
#  Um hook de pre-commit recusa o commit se este arquivo tiver algum valor.
# =============================================================================

# -----------------------------------------------------------------------------
# Upstash Redis (grátis). Vercel > Storage > Marketplace > Upstash for Redis.
# Ao conectar pela Vercel as credenciais são injetadas sozinhas — mas o nome
# varia conforme a integração: KV_REST_API_URL / KV_REST_API_TOKEN é a
# nomenclatura do antigo Vercel KV. O app aceita as duas formas.
# Confira em /api/health quais existem de verdade no ambiente.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Telegram. Fale com @BotFather, /newbot, e cole o token no .env.local.
# Se o token vazar, revogue com /revoke no @BotFather — quem tem o token pode
# postar em qualquer grupo onde o bot esteja.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Sal dos hashes de SSID e IP. Mínimo 16 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ATENÇÃO: trocar este valor invalida o SSID e o IP de casa já cadastrados —
# eles teriam que ser cadastrados de novo, sem erro visível, só deixando de
# avisar. Defina uma vez e não mexa.
# -----------------------------------------------------------------------------
HASH_SALT=

# -----------------------------------------------------------------------------
# Segredo do endpoint de cron. Sem ele, qualquer um na internet dispararia
# avisos no seu grupo. Gere do mesmo jeito que o HASH_SALT.
# -----------------------------------------------------------------------------
CRON_SECRET=
