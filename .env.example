# ---------------------------------------------------------------------------
# Upstash Redis (grátis). Vercel > Storage > Marketplace > Upstash for Redis.
# Ao conectar pela Vercel estas duas variáveis são injetadas sozinhas.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Telegram. Fale com @BotFather no Telegram, /newbot, e cole o token aqui.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8791108962:AAFnD1TlyWKBlCqfBzPg8qYdFlueaYTmH10

# ---------------------------------------------------------------------------
# Sal dos hashes de SSID e IP. Mínimo 16 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ATENCAO: trocar este valor invalida o SSID e o IP de casa já cadastrados —
# eles teriam que ser cadastrados de novo. Defina uma vez e não mexa.
# ---------------------------------------------------------------------------
HASH_SALT=wcDhVNkZaIuw_BsIMH2VUjw7Snbm8Ao2q8MNhGxlUUo

# ---------------------------------------------------------------------------
# Segredo do endpoint de cron. Sem ele, qualquer um na internet dispararia
# avisos no seu grupo. Gere do mesmo jeito que o HASH_SALT.
# ---------------------------------------------------------------------------
CRON_SECRET=cablkO4ctbRBsoEzvuhiq2NmKe7jKhg7CNBqsZz7lU8
